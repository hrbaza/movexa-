# Copy this file to `.env` and adjust as needed.

# Port the API listens on (dedicated so it never clashes with the frontend dev port)
API_PORT=5000

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# JWT signing secret — change this in production!
JWT_SECRET=movexa_dev_secret_change_me
JWT_EXPIRES_IN=7d

# --- Database ---
# Leave MONGODB_URI empty to use the in-memory MongoDB (mongodb-memory-server).
# Set it to a real connection string (e.g. MongoDB Atlas) to persist data:
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/movexa
MONGODB_URI=

# --- TMDB (The Movie Database) ---
# When set, the catalog is seeded from live TMDB data (real posters, cast, trailers)
# and the admin "Import from TMDB" tool is enabled. Leave empty to use sample data.
# Get a free key: https://www.themoviedb.org/settings/api
# Works with either a v3 API key (32-char hex) OR a v4 read access token (JWT).
TMDB_API_KEY=

# --- Wyzie Subs ---
# Keep this server-side. Never prefix it with VITE_ or expose it in browser code.
# Get/rotate a key at https://store.wyzie.io/redeem
WYZIE_API_KEY=

# How many movies to pull from TMDB on seed (default 100, max 500).
# Higher = richer catalog but slower first boot (one API call per movie).
TMDB_SEED_COUNT=100
